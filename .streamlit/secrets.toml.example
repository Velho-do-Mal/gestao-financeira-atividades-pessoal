# .streamlit/secrets.toml.example
# Copie para .streamlit/secrets.toml e preencha os valores reais.
# NUNCA commitar o arquivo secrets.toml — já está no .gitignore.

[database]
url = "postgresql://usuario:senha@host/banco?sslmode=require"

[email]
smtp_host     = "smtp.gmail.com"
smtp_port     = 587
smtp_user     = "seu_email@gmail.com"
smtp_password = "sua_senha_de_app_google"
# Lista de destinatários separados por vírgula, ou array TOML:
recipients    = ["email1@exemplo.com", "email2@exemplo.com"]
