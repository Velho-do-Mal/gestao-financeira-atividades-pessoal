# Copie para .env (nunca commitar o .env real) ou configure como
# variáveis de ambiente no Railway (Project → Variables).

# ─── Banco de dados (Neon Postgres) ────────────────────────────────
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require&channel_binding=require

# ─── Login único do app ────────────────────────────────────────────
APP_USERNAME=velho
APP_PASSWORD=troque-esta-senha
# Chave usada para assinar o cookie de sessão do Flask — gere uma string
# aleatória longa (ex.: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-esta-chave

# ─── E-mail (SMTP) — digest diário e alertas ───────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app_google
# Destinatários separados por vírgula
EMAIL_RECIPIENTS=marcio@bk-engenharia.com,mnknopp@gmail.com

# ─── Digest diário ──────────────────────────────────────────────────
# Horário local (America/Sao_Paulo) em que o e-mail diário é enviado, 0-23
DIGEST_HOUR=7
DIGEST_MINUTE=0
DIGEST_TIMEZONE=America/Sao_Paulo
